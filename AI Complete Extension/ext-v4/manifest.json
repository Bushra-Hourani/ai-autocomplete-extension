{
  "manifest_version": 3,
  "name": "AI Autocomplete Copilot",
  "version": "4.0",
  "description": "AI inline autocomplete for any website including Google Docs.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "icons": { "128": "icons/icon.png" }
}
